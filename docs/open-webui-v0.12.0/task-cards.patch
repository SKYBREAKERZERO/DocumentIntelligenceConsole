index 0000000..c83e676
--- /dev/null
+++ b/src/lib/components/chat/Placeholder/TaskCards.svelte
@@ -0,0 +1,137 @@
+<script lang="ts">
+	import { getContext } from 'svelte';
+	import Document from '$lib/components/icons/Document.svelte';
+	import DocumentCheck from '$lib/components/icons/DocumentCheck.svelte';
+	import DocumentChartBar from '$lib/components/icons/DocumentChartBar.svelte';
+	import Clipboard from '$lib/components/icons/Clipboard.svelte';
+
+	const i18n: any = getContext('i18n');
+
+	type TaskId = 'qa-bug-search' | 'spec-search' | 'test-design' | 'bug-trends';
+
+	export let hasDraft: boolean;
+	export let onInsert: (template: string) => void;
+	export let onSelectTask: (taskId: TaskId | null) => boolean = () => true;
+
+	let selectedTaskId: TaskId | null = null;
+	let testDesignMode = 'case';
+
+	$: testDesignTemplates = {
+		case: $i18n.t('Generate test cases\nTest target: \nScope and focus: '),
+		exploration: $i18n.t('Generate exploratory test ideas\nTest target: \nScope and focus: ')
+	};
+
+	$: tasks = [
+		{
+			id: 'qa-bug-search' as const,
+			icon: DocumentCheck,
+			title: $i18n.t('QA / BUG search'),
+			description: $i18n.t('Find previous answers, bugs, and resolutions.'),
+			template: $i18n.t(
+				'Find relevant QA records and bugs, and summarize their conclusions with sources.\nQuestion or bug: \nFeature or version: '
+			)
+		},
+		{
+			id: 'spec-search' as const,
+			icon: Document,
+			title: $i18n.t('Specification search'),
+			description: $i18n.t('Find requirements and explain specification workflows.'),
+			template: $i18n.t(
+				'Find the relevant specification, explain the requirements or workflow, and cite the source.\nSpecification or feature: \nQuestion: '
+			)
+		},
+		{
+			id: 'test-design' as const,
+			icon: Clipboard,
+			title: $i18n.t('Test cases / exploration'),
+			description: $i18n.t('Generate test cases or exploratory testing ideas.'),
+			template: testDesignTemplates[testDesignMode]
+		},
+		{
+			id: 'bug-trends' as const,
+			icon: DocumentChartBar,
+			title: $i18n.t('BUG trend analysis'),
+			description: $i18n.t('Analyze bug trends by time, module, and version.'),
+			template: $i18n.t(
+				'Enter years, months, or dates. Leave the period blank for the last six complete months.\nReporting period: \nIssue type: \nModule: \nSoftware version: \nQuestion: '
+			)
+		}
+	];
+
+	$: selectedTask = tasks.find((task) => task.id === selectedTaskId);
+</script>
+
+<section aria-label={$i18n.t('Task shortcuts')} class="mb-4 text-left">
+	<div class="mb-2 flex flex-wrap items-baseline gap-x-2 gap-y-1 px-0.5">
+		<h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">
+			{$i18n.t('Task shortcuts')}
+		</h2>
+		<p class="text-xs text-gray-500 dark:text-gray-400">
+			{$i18n.t('Choose a task to see what to provide.')}
+		</p>
+	</div>
+	<div class="grid grid-cols-1 gap-2 @sm:grid-cols-2">
+		{#each tasks as task (task.id)}
+			<button
+				type="button"
+				aria-pressed={selectedTaskId === task.id}
+				class="flex min-w-0 items-start gap-2.5 rounded-xl border border-gray-200 px-3 py-2.5 text-left transition-colors hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 aria-pressed:border-blue-500 aria-pressed:bg-blue-50 dark:border-gray-800 dark:hover:bg-gray-800 dark:aria-pressed:border-blue-500 dark:aria-pressed:bg-blue-950/40"
+				on:click={() => {
+					const nextTask = selectedTaskId === task.id ? null : task.id;
+					if (onSelectTask(nextTask)) {
+						selectedTaskId = nextTask;
+					}
+				}}
+			>
+				<span class="mt-0.5 shrink-0 text-blue-600 dark:text-blue-400" aria-hidden="true">
+					<svelte:component this={task.icon} className="size-4" />
+				</span>
+				<span class="min-w-0">
+					<span class="block text-sm font-medium text-gray-900 dark:text-gray-100">
+						{task.title}
+					</span>
+					<span class="mt-0.5 block text-xs text-gray-600 dark:text-gray-400">
+						{task.description}
+					</span>
+				</span>
+			</button>
+		{/each}
+	</div>
+
+	{#if selectedTask}
+		<div class="mt-2 rounded-xl bg-gray-50 px-3 py-3 dark:bg-gray-900">
+			{#if selectedTask.id === 'test-design'}
+				<div class="mb-2 flex flex-wrap gap-2">
+					{#each [['case', $i18n.t('Test cases')], ['exploration', $i18n.t('Exploratory test ideas')]] as [mode, label]}
+						<button
+							type="button"
+							aria-pressed={testDesignMode === mode}
+							class="rounded-md border border-gray-200 px-2 py-1 text-xs hover:bg-gray-100 aria-pressed:border-blue-500 aria-pressed:text-blue-700 dark:border-gray-700 dark:hover:bg-gray-800 dark:aria-pressed:text-blue-300"
+							on:click={() => (testDesignMode = mode)}
+						>
+							{label}
+						</button>
+					{/each}
+				</div>
