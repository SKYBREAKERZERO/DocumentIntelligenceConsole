      "chapter_id": "2",
      "section_id": "2.1",
      "page_number": 2,
      "text": "The controller shall stop Bluetooth playback within 500 ms after ignition becomes OFF, unless an emergency call is active.",
      "chunk_index": 0,
      "token_count": 19
    },
    {
      "chapter_id": "2",
      "section_id": "2.2",
      "page_number": 3,
      "text": "When reception is lost, Bluetooth audio may be silent, but Bluetooth Audio mode shall remain active. If reception recovers within 3 seconds, playback shall resume automatically.",
      "chunk_index": 0,
      "token_count": 26
    },
    {
      "chapter_id": "2",
      "section_id": "2.4",
      "page_number": 4,
      "text": "The legacy PIN pairing prompt shall appear before Bluetooth playback starts.",
      "chunk_index": 0,
      "token_count": 11
    },
    {
      "chapter_id": "2",
      "section_id": "2.5",
      "page_number": 5,
      "text": "See specification 990201 section 3.1 for emergency call audio priority.",
      "chunk_index": 0,
      "token_count": 10
    }
